# keel environment — copy to .env (gitignored). No secrets ever live in git.
# The Docker image is BUILT BY GITHUB ACTIONS and pushed to Docker Hub;
# the local host only pulls. Set APP_IMAGE to the tag printed in the
# latest successful build-image run (Actions run summary).
APP_IMAGE=navanwar021/work-repo:keel-dev-YYYYMMDD-<sha7>

# LLM provider (mock needs no key; the rest read their keys from the
# environment at runtime, never from this file)
KEEL_PROVIDER=mock
# KEEL_PROVIDER=ollama
# KEEL_PROVIDER=openai
# KEEL_PROVIDER=anthropic

# Provider configuration (no secrets)
# KEEL_PROVIDERS_CONFIG=config/providers.json
# KEEL_OPENAI_BASE_URL=https://api.openai.com/v1
# KEEL_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# KEEL_OLLAMA_URL=http://ollama:11434